ARG PYTHON_VERSION=3.12
FROM public.ecr.aws/lambda/python:${PYTHON_VERSION}

RUN pip install --no-cache-dir \
    fastapi>=0.115.0 \
    pydantic>=2.0.0 \
    boto3>=1.35.0 \
    fastmcp>=3.0.0b1 \
    mcp>=1.0.0

COPY mcp-servers/talent-kb/src/ ${LAMBDA_TASK_ROOT}/
COPY shared/utils/ ${LAMBDA_TASK_ROOT}/utils/

CMD ["lambda_handler.lambda_handler"]
